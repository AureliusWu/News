APP_ENV=development
APP_NAME=Global News
APP_VERSION=0.2.0
COMPOSE_PROJECT_NAME=global-news
POSTGRES_DB=global_news
POSTGRES_USER=global_news
POSTGRES_PASSWORD=GENERATE_LOCAL_SECRET
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_MODE=local
DATABASE_URL=
DATABASE_URL_DOCKER=
DATABASE_URL_LOCAL=
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
MINIFLUX_URL=http://miniflux:8080
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=GENERATE_LOCAL_SECRET
MINIFLUX_DB_PASSWORD=GENERATE_LOCAL_SECRET
RSSHUB_URL=http://rsshub:1200
NEWS_SYNC_INTERVAL_SECONDS=60
NEWS_INITIAL_LOOKBACK_DAYS=5
NEWS_INITIAL_FULL_REFRESH=false
SOURCE_REGISTRY_PATH=config/sources.yaml
VITE_API_BASE_URL=